# Ten buildings; three with two compiled floors each; ten Room Agent designs.
SHOWCASE_CONFIG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "${SHOWCASE_CONFIG_DIR}/full_pipeline.env"
INCLUDE_INTERIORS=true
INTERIOR_BUILDING_LIMIT=3
INTERIOR_FLOOR_LIMIT=2
HERO_ROOM_REFINEMENTS=10
MAX_BUILDING_FLOOR_CALLS=3
MODEL_MAX_TOKENS=8192
MODEL_TIMEOUT=240
MAX_TOTAL_MODEL_CALLS=140
MAX_TOTAL_TOKENS=700000
MAX_TOUCHED_ENTITIES=160
MAX_WALL_TIME=7200
MAX_REPAIR_ROUNDS=4
INCOMING_ASSET_CURATION_ENABLED=false
OUTDOOR_ASSET_PACK_ENABLED=false
ASSET_WORKER_GPU=1
MAX_GENERATED_ASSETS=4
REVIEW_MAX_GENERATED_ASSETS=2
REVIEW_MAX_VIEWS=17
REVIEW_BATCH_SIZE=3
REVIEW_MAX_ROOM_REFINEMENTS=2
REVIEW_MAX_ROOM_LAYOUT_REFINEMENTS=2
REVIEW_MAX_BUILDING_REFINEMENTS=0
REVIEW_MAX_STREETSCAPE_REFINEMENTS=1
REVIEW_ARCHETYPE_CONTACT_SHEETS=false
VIEWER_PORT=5237
