# At the current RequirementPolicy limit; not a browser performance guarantee.
CITY200_CONFIG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "${CITY200_CONFIG_DIR}/full_pipeline.env"
export NO_PROXY=127.0.0.1,localhost,::1
export no_proxy=127.0.0.1,localhost,::1
MODEL_TIMEOUT=300
MODEL_MAX_TOKENS=8192
MODEL_SEED=20260929
MAX_CALLS_PER_AGENT=8
BUILDING_FLOOR_AGENT_ENABLED=false
MAX_BUILDING_FLOOR_CALLS=0
HERO_ROOM_REFINEMENTS=0
INCLUDE_INTERIORS=false
MAX_STREETSCAPE_CALLS=6
MAX_REPAIR_ROUNDS=4
MAX_TOTAL_MODEL_CALLS=96
MAX_TOTAL_TOKENS=700000
MAX_TOUCHED_ENTITIES=300
MAX_WALL_TIME=21600
# Existing curated assets only; do not start a model on another task's GPU.
ASSET_GENERATION_ENABLED=false
ASSET_WORKER_AUTO_START=false
OUTDOOR_ASSET_GENERATION_ENABLED=false
INCOMING_ASSET_CURATION_ENABLED=false
REVIEW_MAX_VIEWS=12
REVIEW_BATCH_SIZE=2
REVIEW_MAX_BUILDING_REFINEMENTS=2
REVIEW_MAX_ROOM_REFINEMENTS=0
REVIEW_MAX_ROOM_LAYOUT_REFINEMENTS=0
REVIEW_MAX_STREETSCAPE_REFINEMENTS=2
REVIEW_ARCHETYPE_CONTACT_SHEETS=false
REVIEW_ASSET_LOAD_TIMEOUT=300
REVIEW_SEED=20260929
VIEWER_PORT=5239
