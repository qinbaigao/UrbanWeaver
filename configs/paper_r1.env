# Paper development fixture, not a held-out benchmark or robot execution.
source "$(dirname "${BASH_SOURCE[0]}")/unified_acceptance.env"
PROTOTYPE_CONFIG=configs/paper_r1_prototypes.json
INTERIOR_BUILDING_LIMIT=2
INTERIOR_FLOOR_LIMIT=2
HERO_ROOM_REFINEMENTS=6
MODEL_SEED=101
MODEL_MAX_TOKENS=6144
MAX_TOTAL_MODEL_CALLS=90
MAX_TOTAL_TOKENS=600000
MAX_WALL_TIME=5400
# Freeze the existing library for structural debugging; no worker/downloads.
INCOMING_ASSET_CURATION_ENABLED=false
ASSET_GENERATION_ENABLED=false
ASSET_WORKER_AUTO_START=false
OUTDOOR_ASSET_GENERATION_ENABLED=false
OUTDOOR_ASSET_PACK_ENABLED=false
MAX_GENERATED_ASSETS=0
OUTDOOR_MAX_GENERATED_ASSETS=0
REVIEW_MAX_GENERATED_ASSETS=0
# R1 observes the generated version without autonomous visual redesign.
REVIEW_MAX_BUILDING_REFINEMENTS=0
REVIEW_MAX_ROOM_REFINEMENTS=0
REVIEW_MAX_ROOM_LAYOUT_REFINEMENTS=0
REVIEW_MAX_STREETSCAPE_REFINEMENTS=0
REVIEW_ARCHETYPE_CONTACT_SHEETS=false
REVIEW_MAX_VIEWS=16
REVIEW_BATCH_SIZE=2
REVIEW_ASSET_LOAD_TIMEOUT=240
VIEWER_PORT=5517
