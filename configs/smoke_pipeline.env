# Fast end-to-end smoke profile. It exercises asset auditing, agent planning,
# OpenUSD compilation, portable Viewer export, and VLM review without blocking
# on optional Hunyuan generation for every missing outdoor slot.
PYTHON_BIN=python
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=cityg-llm
VLM_BASE_URL=http://127.0.0.1:8000/v1
VLM_MODEL=cityg-llm
MODEL_TIMEOUT=180
MODEL_MAX_TOKENS=3072
MODEL_SEED=17
MAX_ATTEMPTS=3
MAX_CALLS_PER_AGENT=4
BUILDING_FLOOR_AGENT_ENABLED=true
MAX_BUILDING_FLOOR_CALLS=4
STREETSCAPE_AGENT_ENABLED=true
MAX_STREETSCAPE_CALLS=3
MAX_REPAIR_ROUNDS=2
MAX_TOTAL_MODEL_CALLS=32
MAX_TOTAL_TOKENS=220000
MAX_TOUCHED_ENTITIES=24
MAX_WALL_TIME=900
BACKEND=openusd
ASSET_REGISTRY=assets/asset_registry.json
FACADE_ASSET_SYSTEM_ENABLED=true
FACADE_ASSET_INDEX=assets/facades/asset_annotations_reviewed.json
MATERIAL_LIBRARY=assets/material_library.json
MEMORY_ENABLED=true
HERO_ROOM_REFINEMENTS=10
# Keep the smoke scene focused on city-scale visuals; enable for floor/room runs.
INCLUDE_INTERIORS=false
ASSET_GENERATION_ENABLED=false
OUTDOOR_ASSET_PACK_ENABLED=true
OUTDOOR_ASSET_GENERATION_ENABLED=false
OUTDOOR_ASSET_MANIFEST=assets/outdoor/pack.json
INCOMING_ASSET_CURATION_ENABLED=true
INCOMING_ASSET_ROOT=assets/incoming
EXTERNAL_ASSET_CACHE=assets/external_cache
INCOMING_ASSET_MANIFEST=assets/incoming_manifest.json
EXTERNAL_ASSET_SOURCES=assets/external_sources.json
REVIEW_SUBDIR=visual_review
VIEWER_PORT=5212
REVIEW_MAX_VIEWS=4
REVIEW_ASSET_LOAD_TIMEOUT=180
REVIEW_BATCH_SIZE=2
REVIEW_MAX_BUILDING_REFINEMENTS=1
REVIEW_MAX_ROOM_REFINEMENTS=1
REVIEW_MAX_ROOM_LAYOUT_REFINEMENTS=1
REVIEW_MAX_STREETSCAPE_REFINEMENTS=1
REVIEW_ARCHETYPE_CONTACT_SHEETS=true
REVIEW_MAX_ARCHETYPE_CANDIDATES=3
REVIEW_MAX_GENERATED_ASSETS=2
REVIEW_SEED=17
