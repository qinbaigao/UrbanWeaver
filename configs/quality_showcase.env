# CityG quality-oriented showcase profile.
#
# This profile inherits the normal full pipeline and raises only the budgets
# that materially affect a medium-scale, publication-quality scene. Select it
# with CITYG_CONFIG=configs/quality_showcase.env; the public runner interface
# remains just the natural-language instruction and output directory.

QUALITY_CONFIG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1091
source "${QUALITY_CONFIG_DIR}/full_pipeline.env"

# Cover every building in the 30-building showcase with the building-specific
# floor agent, while retaining bounded failure recovery.
MAX_BUILDING_FLOOR_CALLS=30
MAX_STREETSCAPE_CALLS=5
MAX_REPAIR_ROUNDS=4
MAX_TOTAL_MODEL_CALLS=140
# A 30-building run uses progressive disclosure for each realized floor plate:
# the measured building-specific batch alone consumed about 434k tokens. Leave
# enough headroom for Hero Room and Streetscape Agents without weakening their
# prompts or silently dropping later stages.
MAX_TOTAL_TOKENS=900000
MAX_TOUCHED_ENTITIES=96
MAX_WALL_TIME=7200

# Concentrate detailed room planning on a representative subset. Compiling
# every room remains deterministic, but only these rooms pay the agent cost.
HERO_ROOM_REFINEMENTS=16

# Keep local asset generation bounded: the curated registry remains primary,
# while genuinely missing semantic assets may still be generated.
MAX_GENERATED_ASSETS=12
OUTDOOR_MAX_GENERATED_ASSETS=6

# Broader adaptive evidence and larger, still-bounded repair capacity.
REVIEW_MAX_VIEWS=16
REVIEW_BATCH_SIZE=4
REVIEW_MAX_BUILDING_REFINEMENTS=3
REVIEW_MAX_ROOM_REFINEMENTS=3
REVIEW_MAX_ROOM_LAYOUT_REFINEMENTS=4
REVIEW_MAX_STREETSCAPE_REFINEMENTS=4
REVIEW_MAX_ARCHETYPE_CANDIDATES=4
REVIEW_MAX_GENERATED_ASSETS=8
