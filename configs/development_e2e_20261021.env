# Live development regression: isolate reviewed assets and keep GPU memory free
# for the already-running LLM/VLM. This profile does NOT exercise mesh generation.
source "$(dirname "${BASH_SOURCE[0]}")/reliability_acceptance.env"
ASSET_GENERATION_ENABLED=false
ASSET_WORKER_AUTO_START=false
ASSET_REQUIRE_HEALTH=false
INCOMING_ASSET_CURATION_ENABLED=false
OUTDOOR_ASSET_PACK_ENABLED=false
OUTDOOR_ASSET_GENERATION_ENABLED=false
PROTOTYPE_CONFIG=configs/algorithm_smoke_prototypes.json
MAX_TOTAL_MODEL_CALLS=80
MAX_TOTAL_TOKENS=500000
MAX_WALL_TIME=3600
REVIEW_MAX_VIEWS=12
REVIEW_BATCH_SIZE=2
REVIEW_ARCHETYPE_CONTACT_SHEETS=true
VIEWER_PORT=5517
