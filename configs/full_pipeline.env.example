# CityG full pipeline configuration.
# Edit this file instead of changing scripts/run_cityg_pipeline.sh.

# Python/runtime
PYTHON_BIN=python
# Concise live terminal progress; full diagnostics remain in output/logs.
CITYG_PROGRESS=true
CITYG_PROGRESS_INTERVAL=30

# LLM/VLM OpenAI-compatible endpoints. The current local Qwen service can serve
# both planning and visual review when multimodal requests are enabled.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=cityg-llm
VLM_BASE_URL=http://127.0.0.1:8000/v1
VLM_MODEL=cityg-llm
MODEL_TIMEOUT=180
# Per-response output bound, not a cumulative usage quota.
MODEL_MAX_TOKENS=6144
MODEL_SEED=17

# Deterministic agent-build budgets
MAX_ATTEMPTS=3
# Proposal/invalid-action attempts; successful disclosure uses its own bounded rounds.
# All actual calls still count toward MAX_TOTAL_MODEL_CALLS.
MAX_CALLS_PER_AGENT=4
BUILDING_FLOOR_AGENT_ENABLED=true
MAX_BUILDING_FLOOR_CALLS=12
STREETSCAPE_AGENT_ENABLED=true
# Attempts per road batch (default batch size: 8); failed batches keep their baseline.
MAX_STREETSCAPE_CALLS=3
MAX_REPAIR_ROUNDS=3
MAX_TOTAL_MODEL_CALLS=48
# 0 = unlimited cumulative input + output tokens; retries remain bounded.
MAX_TOTAL_TOKENS=0
MAX_TOUCHED_ENTITIES=48
MAX_WALL_TIME=1200

# Canonical compilation and local asset registry
BACKEND=openusd
ASSET_REGISTRY=assets/asset_registry.json
FACADE_ASSET_SYSTEM_ENABLED=true
FACADE_ASSET_INDEX=assets/facades/asset_annotations_reviewed.json
MATERIAL_LIBRARY=assets/material_library.json
INCOMING_ASSET_CURATION_ENABLED=true
INCOMING_ASSET_ROOT=assets/incoming
EXTERNAL_ASSET_CACHE=assets/external_cache
INCOMING_ASSET_MANIFEST=assets/incoming_manifest.json
EXTERNAL_ASSET_SOURCES=assets/external_sources.json
MEMORY_ENABLED=true
# Number of representative rooms to send through the expensive Room Agent.
# Set to 0 to keep deterministic-only room furnishing.
HERO_ROOM_REFINEMENTS=10

# Unified generation: references guide planning; counts remain user-controlled.
# Legacy custom configs without this variable keep their previous behavior.
PROTOTYPE_CONFIG=configs/generation_prototypes.json

# City-scale visual iteration can omit interior geometry while preserving the
# canonical room plans in city.json. Set true for floor/room screenshots.
INCLUDE_INTERIORS=true

# Enable after preparing a Hunyuan worker or setting ASSET_URL.
ASSET_GENERATION_ENABLED=false
ASSET_URL=http://127.0.0.1:8091
ASSET_TIMEOUT=1800
MAX_GENERATED_ASSETS=8
ASSET_TEXTURE=true
ASSET_REQUIRE_HEALTH=true
ASSET_WORKER_AUTO_START=false
# GPU index exposed to the Hunyuan worker when it is auto-started. Keep this
# separate from the vLLM GPU assignment. Do not put CUDA_VISIBLE_DEVICES in
# ASSET_WORKER_CMD; the runner injects it from this value.
ASSET_WORKER_GPU=0
ASSET_WORKER_CMD='bash scripts/run_hunyuan_asset_worker.sh'
ASSET_START_ATTEMPTS=120
ASSET_START_INTERVAL=2
ASSET_WORKER_LOG=asset_worker.log

# Semantic outdoor pack. Downloaded incoming packs are curated before this
# audit; missing slots can still use the bounded Hunyuan path or procedural
# fallback.
OUTDOOR_ASSET_PACK_ENABLED=true
OUTDOOR_ASSET_MANIFEST=assets/outdoor/pack.json
OUTDOOR_ASSET_GENERATION_ENABLED=true
OUTDOOR_MAX_GENERATED_ASSETS=4

# Adaptive screenshot -> VLM -> refinement -> local re-render stage
REVIEW_SUBDIR=visual_review
# Headless review starts several temporary servers. Let the OS allocate ports
# so parallel pipelines cannot collide with each other's local recheck server.
VIEWER_PORT=0
REVIEW_ASSET_LOAD_TIMEOUT=180
REVIEW_MAX_VIEWS=8
REVIEW_BATCH_SIZE=4
REVIEW_MAX_BUILDING_REFINEMENTS=1
REVIEW_MAX_ROOM_REFINEMENTS=1
REVIEW_MAX_ROOM_LAYOUT_REFINEMENTS=1
REVIEW_MAX_STREETSCAPE_REFINEMENTS=2
REVIEW_ARCHETYPE_CONTACT_SHEETS=true
REVIEW_MAX_ARCHETYPE_CANDIDATES=4
REVIEW_MAX_GENERATED_ASSETS=4
REVIEW_SEED=17
