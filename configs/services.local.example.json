{
  "llm": {
    "provider": "openai_compatible",
    "base_url": "http://127.0.0.1:8000/v1",
    "model": "cityg-llm",
    "api_key_env": "CITYG_MODEL_API_KEY",
    "temperature": 0.7,
    "top_p": 0.8,
    "max_tokens": 1536,
    "enable_thinking": false
  },
  "vlm": {
    "provider": "openai_compatible",
    "base_url": "http://127.0.0.1:8001/v1",
    "model": "replace-with-local-vlm-name",
    "api_key_env": "CITYG_VLM_API_KEY"
  },
  "simulation": {
    "backend": "manifest"
  },
  "traffic": {
    "backend": "disabled"
  }
}
