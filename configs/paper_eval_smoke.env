# Fixed existing assets isolate planning from asset-provider latency.
source "$(dirname "${BASH_SOURCE[0]}")/reliability_acceptance.env"
# Evaluation uses the prepared registry; do not curate or fill packs mid-run.
INCOMING_ASSET_CURATION_ENABLED=false
OUTDOOR_ASSET_PACK_ENABLED=false
ASSET_GENERATION_ENABLED=false
ASSET_WORKER_AUTO_START=false
ASSET_REQUIRE_HEALTH=false
MAX_GENERATED_ASSETS=0
OUTDOOR_ASSET_GENERATION_ENABLED=false
OUTDOOR_MAX_GENERATED_ASSETS=0
REVIEW_MAX_GENERATED_ASSETS=0
VIEWER_PORT=5437
