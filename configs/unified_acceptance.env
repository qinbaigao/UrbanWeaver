# Small real-model acceptance via the ordinary two-argument pipeline.
source "$(dirname "${BASH_SOURCE[0]}")/full_pipeline.env"
MODEL_MAX_TOKENS=6144
MAX_TOTAL_MODEL_CALLS=80
MAX_TOTAL_TOKENS=500000
MAX_WALL_TIME=3600
ASSET_WORKER_GPU=3
MAX_GENERATED_ASSETS=2
OUTDOOR_MAX_GENERATED_ASSETS=1
REVIEW_MAX_GENERATED_ASSETS=1
REVIEW_BATCH_SIZE=2
# Six views are consumed by global/road/facade reservations; leave room views
# in the actual acceptance budget as well.
REVIEW_MAX_VIEWS=16
VIEWER_PORT=5217
